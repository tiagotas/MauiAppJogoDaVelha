
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppJogoDaVelha.MainPage"
             BackgroundColor="#0B1F3A">

    <ContentPage.Resources>

        <!-- Estilo dos botoes do tabuleiro -->
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#142B49" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="TextColor" Value="#D4AF37" />
            <Setter Property="FontSize" Value="54" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="BorderColor" Value="#D4AF37" />
        </Style>

        <!-- Estilo dos textos -->
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#D4AF37" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>

    </ContentPage.Resources>

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="15">

        <!-- Cabecalho -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="6"
                             VerticalOptions="Center">

            <Label Text="JOGO DA VELHA"
                   FontSize="30"
                   TextColor="#D4AF37"
                   HorizontalTextAlignment="Center" />

            <Label Text="DESAFIE SEU AMIGO"
                   FontSize="14"
                   TextColor="#D4AF37"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <!-- Tabuleiro 3 por 3 -->
        <Grid Grid.Row="2"
              RowDefinitions="*,*,*"
              ColumnDefinitions="*,*,*"
              RowSpacing="10"
              ColumnSpacing="10"
              MaximumWidthRequest="420"
              MaximumHeightRequest="420"
              HorizontalOptions="Center"
              VerticalOptions="Center">

            <Button x:Name="btn10"
                    Grid.Row="0" Grid.Column="0"
                    Clicked="Button_Clicked" />

            <Button x:Name="btn11"
                    Grid.Row="0" Grid.Column="1"
                    Clicked="Button_Clicked" />

            <Button x:Name="btn12"
                    Grid.Row="0" Grid.Column="2"
                    Clicked="Button_Clicked" />

            <Button Grid.Row="1" Grid.Column="0"
                    Clicked="Button_Clicked" />

            <Button Grid.Row="1" Grid.Column="1"
                    Clicked="Button_Clicked" />

            <Button Grid.Row="1" Grid.Column="2"
                    Clicked="Button_Clicked" />

            <Button Grid.Row="2" Grid.Column="0"
                    Clicked="Button_Clicked" />

            <Button Grid.Row="2" Grid.Column="1"
                    Clicked="Button_Clicked" />

            <Button Grid.Row="2" Grid.Column="2"
                    Clicked="Button_Clicked" />

        </Grid>

    </Grid>

</ContentPage>
